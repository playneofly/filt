<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    ─────────────────
    صفحه اصلی اپ: شامل NavHostFragment برای مدیریت Fragment‌ها
    و BottomNavigationView برای ناوبری بین صفحات.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fn_snow"
    tools:context=".MainActivity">

    <!-- ══════════════════════════════════════
         هدر برنامه (لوگو + نام + دکمه تم)
    ══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="20dp"
        android:background="@color/fn_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- لوگو + نام -->
        <LinearLayout
            android:id="@+id/header_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:importantForAccessibility="yes" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <!-- نام FILTERNET با دو رنگ (باید از Spannable در Kotlin ست شود) -->
                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/fn_ink"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tv_app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/fn_faint"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- دکمه تغییر تم -->
        <ImageButton
            android:id="@+id/btn_theme_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_moon"
            android:padding="9dp"
            android:contentDescription="تغییر تم"
            android:tint="@color/fn_sub"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- خط جداکننده ظریف زیر هدر -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/fn_line"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         محتوا: NavHostFragment
    ══════════════════════════════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         BottomNavigationView
    ══════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fn_card"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@drawable/selector_nav_item"
        app:itemTextColor="@drawable/selector_nav_item"
        app:itemActiveIndicatorColor="@color/fn_accent"
        app:itemActiveIndicatorStyle="@style/Widget.Filternet.BottomNav"
        app:labelVisibilityMode="labeled"
        app:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
