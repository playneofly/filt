<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_servers.xml
    ─────────────────────
    صفحه سرورها: جستجو + دکمه اتصال هوشمند + RecyclerView لیست سرورها
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:background="@color/fn_snow"
    tools:context=".ServersFragment">

    <!-- عنوان -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/servers_title"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/fn_ink"
        android:letterSpacing="-0.02"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="۱۰ لوکیشن فعال · انتخاب هوشمند بر اساس پینگ"
        android:textSize="11sp"
        android:textColor="@color/fn_sub"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- جستجو -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/fn_line"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_search"
                android:tint="@color/fn_faint"
                android:layout_marginStart="8dp"
                android:contentDescription="جستجو" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:textSize="12.5sp"
                android:textColor="@color/fn_ink"
                android:hintTextColor="@color/fn_faint"
                android:background="@null"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- دکمه اتصال هوشمند -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_smart_connect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/search_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:background="@drawable/bg_gradient_accent_light"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sparkles"
                android:tint="@color/white"
                android:background="@drawable/bg_gradient_accent"
                android:padding="11dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_connect_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/fn_ink" />

                <TextView
                    android:id="@+id/tv_smart_ping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بهترین سرعت با پینگ ۴۳ ms"
                    android:textSize="10.5sp"
                    android:textColor="@color/fn_sub"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggested"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/fn_accent"
                android:background="@drawable/bg_badge_accent"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- عنوان لیست -->
    <TextView
        android:id="@+id/tv_list_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/all_locations"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/fn_ink"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/card_smart_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- لیست سرورها -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_servers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_list_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="8"
        tools:listitem="@layout/item_server" />

</androidx.constraintlayout.widget.ConstraintLayout>
